#!/usr/bin/env bash
# Universal evairx opencode installer (Auto-detects Windows, Termux ARM, Linux, macOS)
set -euo pipefail

REPO="evairx/opencode"
VERSION="${VERSION:-}"
BRANCH="${BRANCH:-dev}"

usage() {
    cat <<EOF
evairx opencode Universal Installer

Usage: install [options]
    -v, --version <version>   Install a specific release
    -h, --help                Show this help

Examples:
    # PC (Linux / macOS) or Termux ARM:
    curl -fsSL https://raw.githubusercontent.com/$REPO/$BRANCH/install | bash
    curl -fsSL https://raw.githubusercontent.com/$REPO/$BRANCH/install | bash -s -- --version 1.18.29
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        -v|--version) VERSION="${2:?missing version}"; shift 2 ;;
        *) echo "Unknown option: $1" >&2; usage >&2; exit 1 ;;
    esac
done

MUTED='\033[0;2m'
GREEN='\033[0;32m'
RED='\033[0;31m'
CYAN='\033[0;36m'
NC='\033[0m'

# ----------------------------------------------------
# 1. Termux Detection
# ----------------------------------------------------
if [ -n "${TERMUX_VERSION:-}" ] || [ -d "/data/data/com.termux" ]; then
    echo -e "${GREEN}==>${NC} Detected Android / Termux environment"
    TERMUX_SCRIPT_URL="https://raw.githubusercontent.com/$REPO/$BRANCH/install-termux.sh"
    exec curl -fsSL "$TERMUX_SCRIPT_URL" | bash -s -- ${VERSION:+--version "$VERSION"}
fi

raw_os=$(uname -s)
case "$raw_os" in
    MINGW*|MSYS*|CYGWIN*) os="windows" ;;
    Darwin*) os="darwin" ;;
    Linux*) os="linux" ;;
    *) os="unknown" ;;
esac

# ----------------------------------------------------
# 2. Windows Detection
# ----------------------------------------------------
if [ "$os" = "windows" ]; then
    echo -e "${GREEN}==>${NC} Detected Windows environment"
    echo -e "${MUTED}Delegating to install.ps1 (PowerShell)...${NC}"
    SCRIPT_URL="https://raw.githubusercontent.com/$REPO/$BRANCH/install.ps1"
    if command -v powershell.exe >/dev/null 2>&1; then
        powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "irm '$SCRIPT_URL' | iex"
    elif command -v pwsh >/dev/null 2>&1; then
        pwsh -NoProfile -ExecutionPolicy Bypass -Command "irm '$SCRIPT_URL' | iex"
    else
        echo -e "${RED}PowerShell is required. Run manually:${NC}"
        echo "  powershell -ExecutionPolicy Bypass -c \"irm '$SCRIPT_URL' | iex\""
        exit 1
    fi
    exit 0
fi

# ----------------------------------------------------
# 3. Linux / macOS PC
# ----------------------------------------------------
arch=$(uname -m)
case "$arch" in
    x86_64|amd64) arch="x64" ;;
    aarch64|arm64) arch="arm64" ;;
    *) echo -e "${RED}Unsupported architecture:${NC} $arch"; exit 1 ;;
esac

INSTALL_DIR="${HOME}/.opencode/bin"
mkdir -p "$INSTALL_DIR"

if [ -z "$VERSION" ]; then
    echo -e "${MUTED}Checking latest release from $REPO...${NC}"
    LATEST_JSON=$(curl -fsSL "https://api.github.com/repos/$REPO/releases/latest" 2>/dev/null || true)
    if [ -n "$LATEST_JSON" ]; then
        VERSION=$(echo "$LATEST_JSON" | grep -o '"tag_name": *"[^"]*"' | head -n 1 | cut -d'"' -f4 | sed 's/^v//')
    fi
    if [ -z "$VERSION" ]; then
        VERSION="1.18.29"
    fi
fi

echo -e "${GREEN}==>${NC} Installing evairx opencode v${VERSION} (${os}-${arch})..."

ASSET="opencode-${os}-${arch}.tar.gz"
[ "$os" = "darwin" ] && ASSET="opencode-${os}-${arch}.zip"
RELEASE_URL="https://github.com/$REPO/releases/download/v${VERSION}/${ASSET}"

TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT

if curl -fsSL -I "$RELEASE_URL" >/dev/null 2>&1; then
    echo -e "${GREEN}==>${NC} Downloading $ASSET..."
    curl -fsSL -o "$TMP_DIR/$ASSET" "$RELEASE_URL"
    if [[ "$ASSET" == *.zip ]]; then
        unzip -q "$TMP_DIR/$ASSET" -d "$TMP_DIR"
    else
        tar -xzf "$TMP_DIR/$ASSET" -C "$TMP_DIR"
    fi
    mv "$TMP_DIR/opencode" "$INSTALL_DIR/opencode"
    chmod +x "$INSTALL_DIR/opencode"
else
    echo -e "${RED}Asset not found at $RELEASE_URL${NC}"
    echo "You can build locally with: cd packages/opencode && bun run script/build.ts --single"
    exit 1
fi

# Ensure ~/.opencode/bin is on PATH
if [[ ":$PATH:" != *":$INSTALL_DIR:"* ]]; then
    echo -e "${MUTED}Adding $INSTALL_DIR to PATH...${NC}"
    SHELL_RC=""
    if [ -n "${ZSH_VERSION:-}" ] || [ -f "$HOME/.zshrc" ]; then
        SHELL_RC="$HOME/.zshrc"
    elif [ -f "$HOME/.bashrc" ]; then
        SHELL_RC="$HOME/.bashrc"
    fi
    if [ -n "$SHELL_RC" ]; then
        echo "export PATH=\"$INSTALL_DIR:\$PATH\"" >> "$SHELL_RC"
    fi
    export PATH="$INSTALL_DIR:$PATH"
fi

echo ""
echo -e "${GREEN}✔ OpenCode installed successfully!${NC}"
echo -e "Run: ${CYAN}opencode${NC}"
